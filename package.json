{
  "name": "jianying-projection",
  "productName": "简影投屏",
  "version": "1.0.0",
  "main": "electron/main.js",
  "type": "commonjs",
  "description": "简影投屏 - 极简主义舞台投影软件",
  "license": "MIT",
  "author": "简影投屏 (JianYing Projection)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node copy-preload.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && node copy-preload.js && electron-builder",
    "electron:build:mac": "vite build && node copy-preload.js && electron-builder --mac",
    "electron:build:win": "vite build && node copy-preload.js && electron-builder --win",
    "electron:build:linux": "vite build && node copy-preload.js && electron-builder --linux",
    "electron:build:intl:mac": "vite build && node copy-preload.js && electron-builder --mac",
    "electron:build:intl:win": "vite build && node copy-preload.js && electron-builder --win",
    "electron:build:intl:linux": "vite build && node copy-preload.js && electron-builder --linux",
    "datapack:build": "node scripts/build-data-pack.js all",
    "datapack:build:bible": "node scripts/build-data-pack.js bible all-bible",
    "datapack:build:songs": "node scripts/build-data-pack.js songs all-songs"
  },
  "dependencies": {
    "fuse.js": "^7.1.1",
    "pptxjs": "^0.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.jianying.projection",
    "productName": "简影投屏",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "preload.js"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Utility"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
