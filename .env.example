# Code Signing & Notarization — Mac
# ---------------------------------
# Required for macOS builds. Get these from Apple Developer Program ($99/year).
# CSC_LINK: Path to your .p12 certificate file, or base64-encoded certificate string
# CSC_KEY_PASSWORD: Password for the .p12 certificate
# APPLE_ID: Your Apple Developer account email
# APPLE_ID_PASSWORD: App-specific password from https://appleid.apple.com
# APPLE_TEAM_ID: Your Team ID from https://developer.apple.com/account
#
# CSC_LINK=/path/to/cert.p12
# CSC_KEY_PASSWORD=your-cert-password
# APPLE_ID=you@example.com
# APPLE_ID_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=ABCDE12345

# Code Signing — Windows
# ----------------------
# Required for Windows builds. Get an EV or OV Code Signing Certificate.
# CSC_LINK: Path to your .pfx or .p12 certificate file
# CSC_KEY_PASSWORD: Password for the certificate
#
# If using the same certificate file as macOS, CSC_LINK and CSC_KEY_PASSWORD above also apply here.

# GitHub Token (for auto-update publishing)
# -----------------------------------------
# Required for the electron-updater publish flow.
# Create at https://github.com/settings/tokens with "repo" scope.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# App-Specific
# ------------
# NODE_ENV=production
